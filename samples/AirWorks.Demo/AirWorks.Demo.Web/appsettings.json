{
  "AirWorks": {
    "Providers": [
      {
        "Id": "keycloak",
        "Title": "Keycloak",
        "Icon": "login-user.png",
        "Authority": "{keycloak}/realms/airworks",
        "ClientId": "airworks-web"
      },
      {
        // Keycloak identity brokering: shows Keycloak's GitHub login directly.
        // Configure a "github" identity provider in the realm first, then set Enabled to true.
        "Enabled": false,
        "Id": "github",
        "Title": "GitHub (via Keycloak)",
        "Authority": "{keycloak}/realms/airworks",
        "ClientId": "airworks-web",
        "ExtraParams": { "kc_idp_hint": "github" }
      },
      {
        // Microsoft Entra ID: register a single-page application with redirect URI http://localhost:5177/
        "Enabled": false,
        "Id": "entra",
        "Title": "Microsoft",
        "Authority": "https://login.microsoftonline.com/<tenant-id>/v2.0",
        "ClientId": "<application-client-id>",
        "Scope": "openid profile email api://<api-client-id>/access"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
